GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
ALLOWED_ORIGINS="http://localhost:4200"

MODEL="gemini-2.5-flash"

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

MONGO_DB_NAME="resume_sync_db"

FRONTEND_UPDATE_URL=http://localhost:4200/employee-dashboard
BACKEND_BASE_URL=http://localhost:8000
SCHEDULER_RUN_DAY=24
SCHEDULER_RUN_HOUR=9
SCHEDULER_RUN_MINUTE=21

# ─────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID SSO
# ─────────────────────────────────────────────────────────────────────────
# From Azure portal -> Entra ID -> App registrations -> <your app>.
# ENTRA_CLIENT_SECRET is the secret's *Value*, not its Secret ID.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Must match a Web redirect URI on the app registration exactly.
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_BASE_URL=http://localhost:4200

# Personas. ADMIN is a named-account allowlist — there is no shared password.
ADMIN_EMAILS=
HR_DEPARTMENTS=HR,TM,TA,IT,Finance,Operations,Business Development,MMS,Management
HR_JOB_TITLES=Director of Technical Delivery-AI,Technical Delivery Manager,Director of Technical Delivery,VP of Technical Delivery,Delivery Manager,TM Business Partner,Account Director,Senior Account Director,Principal Architect,Senior Technical Architect,CBO,CEO
TALENT_POOL_DEPARTMENT=Talent Pool

# Departments IT creates under two different names. "variant=canonical".
DEPARTMENT_ALIASES=SpeechPandit=SpeechPundit,Biz Dev=Business Development,ACA=EFX-ACA,SI9=EFX-SI9,EFX-I9I=EFX-I9I-MSA,AI=AI CoE,Paper Trial=PaperTrail,JobAlign=Job Align,Finanace=Finance

# Departments suppressed from the monthly resume-update email.
EMAIL_EXCLUDED_DEPARTMENTS=HR,TM,TA,IT,Finance,Operations,Business Development,Management,Support,Maternity Leave

# Login gating — interns cannot sign in. Both signals must agree.

# Identity reconciliation — see config/entra_config.py for why each exists.
EMPLOYEE_ID_OVERRIDES=EFX-I9HQ=SS471,SSUS11=SS044
PREFERRED_ACCOUNT_EMAILS=satyasathvik.abhinay@sailssoftware.com,lakshmi.madabattula@sailssoftware.com
PRIMARY_EMAIL_DOMAIN=sailssoftware.com

INTERN_TYPE_MARKERS=intern
INTERN_ID_PREFIX=T

# Session cookie. Local dev over plain http needs samesite=lax + secure=false;
# production across two *.run.app hosts needs none + true.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8

# ─────────────────────────────────────────────────────────────────────────
# Outbound email — Microsoft Graph (Mail.Send). No password required.
# ─────────────────────────────────────────────────────────────────────────
# The mailbox application mail is sent FROM. Must be a real mailbox in the
# tenant. Authentication reuses ENTRA_CLIENT_SECRET above.
GRAPH_MAIL_SENDER=

# "console" logs the message instead of sending. Keep console locally —
# "graph" mails ~280 real employees on a monthly cycle.
EMAIL_DELIVERY_MODE=console

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JOB_TRIGGER_TOKEN=
